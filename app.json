{
  "expo": {
    "name": "Fleg Score",
    "slug": "fleg-score",
    "version": "0.1.0",
    "scheme": "flegscore",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "in.fleg.score",
      "supportsTablet": true
    },
    "android": {
      "package": "in.fleg.score",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FLEG Score to upload event banners and registration files."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    }
  }
}
