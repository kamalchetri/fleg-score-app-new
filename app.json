{
  "expo": {
    "name": "Fleg Score",
    "slug": "fleg-score",
    "version": "0.1.0",
    "scheme": "flegscore",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080F",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "in.fleg.score",
      "supportsTablet": true
    },
    "android": {
      "package": "in.fleg.score",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FLEG Score to upload event banners and registration files."
        }
      ],
      "expo-document-picker",
      "expo-notifications"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d047d73e-179b-45c1-a024-844c62d1ae8f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d047d73e-179b-45c1-a024-844c62d1ae8f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
